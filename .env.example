# OpenAI API キー (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-***

# Anthropic API キー (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-***

# Google Gemini API キー (https://aistudio.google.com/apikey)
GEMINI_API_KEY=***

# Ollama (ローカル) のホスト URL を上書きする場合のみ
# OLLAMA_HOST=http://localhost:11434

# Server bind address (省略時は config.yaml の値を使う)
# GO_LLM_AGENT_ADDR=127.0.0.1:14000
