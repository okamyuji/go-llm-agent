/bin/
/dist/
/.env
/coverage.out
/coverage.html
.DS_Store
.idea/
.vscode/
*.test
*.out

# 個人ローカル設定はコミット対象外。サンプルは config.yaml.example を参照
/config.yaml
/llm-agent-workspace/

# ローカル実験用のモデルバイナリと生成動画はコミット対象外
/models/
/videos/

# docs/design/ は公開設計書として git 管理する
# それ以外の docs サブディレクトリ（plans, specs, notes）と usage.md は個人ローカル保持のままにする
/docs/plans/
/docs/specs/
/docs/notes/
/docs/usage.md

# 15 番設計書 mTLS 用の証明書ファイル
# ルートにある実証明書のみを除外し、tests/ や docs/ 配下の任意の test fixture は許容する
/*.pem
/*.crt
/*.key
/certs/
