# go-llm-agent サンプル設定
# 使い方: `cp config.yaml.example config.yaml` してから編集する。
# 実体の config.yaml は .gitignore 対象（個人ローカル設定）。
# デフォルトは安全寄り (readonly + allowlist + audit)。fs_write/shell を有効にする際は
# README の Security セクションを必ず読むこと。

default_model: gemini/gemini-2.5-pro

providers:
  openai:
    base_url: https://api.openai.com/v1
    api_key_env: OPENAI_API_KEY
    # 許可モデルを明示する（空ならプロバイダー側に委譲）。サプライチェーン耐性のため
    # 検証済みモデルだけをここに列挙することを推奨。
    allow_models:
      - gpt-5-mini
      - gpt-4.1-mini
      - gpt-4o-mini
    # 1,000,000 トークンあたりの円換算単価。未指定なら CostJPY は 0 として集計される。
    pricing:
      input_per_million_jpy: 450
      output_per_million_jpy: 1800
    # 429 や 5xx の retryable エラーに対するリトライ設定。max_attempts<=1 でリトライ無効。
    request_timeout_seconds: 60
    retry:
      max_attempts: 4
      initial_backoff_ms: 200
      max_backoff_ms: 5000
      jitter_ratio: 0.2
    # 連続失敗した場合のフォールバック先プロバイダー名。未指定で無効。
    fallback_to: anthropic
  anthropic:
    base_url: https://api.anthropic.com
    api_key_env: ANTHROPIC_API_KEY
    # ANTHROPIC_API_KEY が未設定の場合、CLI は CLAUDE_API_KEY も互換名として試す。
    allow_models:
      - claude-sonnet-4-6
      - claude-haiku-4-5
    pricing:
      input_per_million_jpy: 480
      output_per_million_jpy: 2400
  gemini:
    base_url: https://generativelanguage.googleapis.com/v1beta
    api_key_env: GEMINI_API_KEY
    allow_models:
      - gemini-2.5-pro
      - gemini-2.5-flash
    pricing:
      input_per_million_jpy: 300
      output_per_million_jpy: 1200
  ollama:
    base_url: http://localhost:11434
    # ローカル Ollama はモデル列挙を端的にしづらいため allow_models は空のままにする
    allow_models: []
    # temperature 非 nil で推論温度を固定 (0 で決定的出力、ベンチマーク再現性向上)。
    # think 非 nil で thinking モードを制御 (Qwen 系 reasoning モデルの空応答回避には false)。
    # どちらも未指定 (コメントアウト) ならリクエストに含めず Ollama 既定値に従う。
    # temperature: 0
    # think: false
  # llama.cpp の llama-server (OpenAI 互換 API) 直結プロバイダー。
  # Ollama デーモンを介さず GGUF を直接ロードし、cache_prompt によるプレフィル再利用を効かせる。
  # 起動例: llama-server -m model.gguf --jinja -c 8192 --port 8080
  # (--jinja は tool calling に必須。model 名はダミー可、llama-server はキー検証をしない)
  llamacpp:
    base_url: http://localhost:8080/v1
    # tool call の arguments 二重エンコード文字列とストリーミング分割は provider 側で
    # 連結・正規化されるため追加設定は不要。prefill が長引くため timeout は長めが安全。
    request_timeout_seconds: 300
    allow_models: []
    # think: false で Qwen 系 reasoning モデルの thinking を抑制する
    # (chat_template_kwargs.enable_thinking=false を送る)。Mistral 系など非 reasoning は未指定でよい。
    # think: false
    # tool_call_id_format: "alnum9" は Mistral-Nemo 系 (Shisa 等) テンプレート専用の対策。
    # そのテンプレートは tool_call_id に「9 文字英数字」を強制し、llama-server 生成の
    # 32 文字 ID を 2 ターン目で 400 拒否する。Qwen 等はこの制約が無いので未指定でよい。
    # tool_call_id_format: "alnum9"

agent:
  max_tool_hops: 8
  # 既定は readonly のみ。fs_write / shell を有効にしたい場合は意図して追記する。
  # enabled_tools を空または未指定にすると Registry が DefaultReadonlyTools を採用する。
  enabled_tools: [fs_read, search_files, http_fetch]
  # system_prompt と system_prompt_file は排他。両方指定するとエラーになる。
  # system_prompt_file は config.yaml からの相対パスでプロンプトファイルを参照する。
  # system_prompt: |
  #   あなたは慎重で正確な開発支援エージェントです。
  system_prompt_file: prompts/coding-accuracy.md
  # コンテキスト拡充 (enricher)。ユーザーメッセージから言語を自動検出し、
  # 対応する言語仕様リファレンスをコンテキストに注入してコーディング精度を向上させる。
  # languages は静的specファイル (dynamic が無効か検索結果が空のときのフォールバック)。
  # dynamic は公式ドキュメントから質問キーワードに関連するセクションだけを
  # 取得して注入する動的検索。取得結果は cache_dir (既定: OSキャッシュディレクトリ) に
  # cache_ttl_hours の間キャッシュされる。
  # 対応言語: ruby / go / python / javascript / typescript / react / csharp /
  # java / springboot / rust (検出キーワードは internal/enricher/enricher.go 参照)
  enricher:
    enabled: true
    prompts_dir: prompts
    languages:
      ruby: ruby-spec.md
      go: go-spec.md
    dynamic:
      enabled: true
      max_sections: 5
      max_bytes: 6000
      cache_ttl_hours: 24
      sources:
        ruby:
          - https://docs.ruby-lang.org/ja/latest/doc/spec=2fvariables.html
          - https://docs.ruby-lang.org/ja/latest/doc/spec=2fcontrol.html
          - https://docs.ruby-lang.org/ja/latest/doc/spec=2flambda_proc.html
        go:
          - https://go.dev/ref/spec
          - https://go.dev/doc/faq
        rust:
          - https://doc.rust-lang.org/book/ch04-01-what-is-ownership.html
        # 他言語 (typescript / react / csharp / java / springboot 等) も
        # 同じ形式で公式ドキュメント URL を列挙する
  # 予算上限。0 は無制限を意味し、上限到達時は agent.Run が ErrBudgetExceeded で停止する。
  # storage.sessions_dir 配下に billing.jsonl が追記される。
  budget:
    session_max_tokens: 200000
    daily_max_cost_jpy: 1000
  # tool_choice の既定値。mode は auto / required / none / tool のいずれか。
  # tool 指定時は name にツール名を入れる。
  tool_choice:
    mode: auto
    name: ""
  # ツール引数の JSON Schema 検証。max_retries 回まで自動修正試行する。
  tool_validation:
    enabled: true
    max_retries: 2
  # HITL ツール承認。required_tools に含まれるツールは人間承認まで実行を保留する。
  # default_decision: "deny" のみサポート (timeout 時の fail-closed)。"allow" は
  # 廃止され、起動時に config エラーで弾かれる。
  # timeout_seconds は required_tools 指定時に正の整数で必須 (起動時 validate)。
  approval:
    required_tools: []
    timeout_seconds: 30
    default_decision: deny
  # 実行戦略の切替。react / planner_executor / reflection から選ぶ。
  strategy: react
  planner_executor:
    planner_model: openai/gpt-4o
    executor_model: openai/gpt-4o-mini
    max_steps: 8
  reflection:
    max_iterations: 3
    trigger_consecutive_failures: 2
    trigger_hop_budget: 6
  # 並列ツール実行。require_approval ツールが含まれる場合は自動的に直列化される。
  parallel_tools:
    enabled: false
    max_concurrency: 4
    fail_fast: false

tools:
  fs:
    # 専用ワークスペースに閉じることを推奨。リポジトリルート ./ は推奨しない。
    allow_paths:
      - ~/Documents/agent-workspace
    # サンドボックス配下でも追加で deny したいパターン（センシティブな .git や .env 等は
    # 設定不要で常に遮断される）。
    deny_paths: []
    max_read_bytes: 1048576
  shell:
    timeout_seconds: 30
    max_timeout_seconds: 300
    # 必要最小限のバイナリのみ列挙する。
    allow_binaries: [git, go, rg, ls, cat, head, tail, sed, awk, grep]
    # 既定の deny 正規表現 (`config --global`, `bash -c`, `core.sshCommand`, `env -w`,
    # `install`, `--exec`, `-c <code>` 等) は常に有効。追加で deny したいパターンを記述する。
    arg_deny_patterns: []
  http_fetch:
    deny_private_networks: true
    timeout_seconds: 15
    max_body_bytes: 2097152
    # 公開取得先を絞り込むため FQDN 末尾一致でホワイトリスト。空なら全公開ドメイン許可。
    # 例: [github.com, raw.githubusercontent.com]
    allow_domains: []
  search_files:
    max_results: 200

server:
  addr: 127.0.0.1:14000
  # Bearer Token 認証。secret_env のみサポートで、値の直書きは config loader が reject する。
  auth:
    enabled: false
    bearer_tokens:
      - id: local
        secret_env: AGENT_LOCAL_TOKEN
  # token bucket レート制限。rps と burst が 0 のときは適用されない。
  rate_limit:
    enabled: false
    rps: 5
    burst: 10
    per_token: true
  # IP allowlist。CIDR を 1 つも書かないと適用されない。
  allowlist:
    cidrs:
      - 127.0.0.1/32
  # CORS プリフライト対応。enabled=true のときだけ反映される。
  cors:
    enabled: false
    allow_origins: []
    allow_methods: [GET, POST, OPTIONS]
    allow_headers: [Authorization, Content-Type]

storage:
  sessions_dir: ~/.local/state/go-llm-agent/sessions
  # ノート保存先 JSONL。空のときは sessions_dir/notes.jsonl を使う。
  notes_path: ""

logging:
  format: text
  level: info

# 入出力フィルタとプロンプトインジェクション検知。output_redactor は既定 on で
# DeltaText / Final / ツール出力に対して機微情報をマスキングする。
safety:
  input_scanner:
    enabled: true
    block_on_match: false
    # ignore_previous / system_role_inject はヒューリスティックな汎用ルール
      # 想定外の自然文に対する偽陽性のリスクがあるため、本番運用ではプロジェクト固有の
      # patterns を追記し、必要なら以下のサンプルルールを差し替えてください
    patterns:
      - id: ignore_previous
        regex: "(?i)ignore (the )?previous instructions"
      - id: system_role_inject
        regex: "(?i)\\[system\\]"
  output_redactor:
    enabled: true
    rules:
      - id: openai_key
        regex: "sk-[A-Za-z0-9]{20,}"
        replacement: "[REDACTED:OPENAI]"
      - id: jwt
        regex: "eyJ[0-9A-Za-z_-]{8,}\\.[0-9A-Za-z_-]{8,}\\.[0-9A-Za-z_-]{8,}"
        replacement: "[REDACTED:JWT]"
      - id: private_key_header
        regex: "-----BEGIN [A-Z ]+PRIVATE KEY-----"
        replacement: "[REDACTED:PRIVATE_KEY]"
      # credit_card はオプション。ID 番号や注文番号など同程度の数字列に対する偽陽性が
      # 出やすいため、本番運用では Luhn 検証を行う別段の OutputRedactor と chain することを推奨する
      # 不要なら以下の 3 行を削除してください
      - id: credit_card
        regex: "\\b(?:\\d[ -]*?){13,19}\\b"
        replacement: "[REDACTED:CARD]"
  # 14 番設計書: PII リダクタ。output_redactor の後段で動作する。
  pii_redactor:
    enabled: true
    rules:
      - id: email
        regex: "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}"
        replacement: "[REDACTED:EMAIL]"
      - id: jp_phone
        regex: "0\\d{1,4}-\\d{1,4}-\\d{3,4}"
        replacement: "[REDACTED:JP_PHONE]"
      - id: jp_mynumber
        regex: "\\b\\d{4}\\s?\\d{4}\\s?\\d{4}\\b"
        replacement: "[REDACTED:JP_MYNUMBER]"
      # ipv4 は 0-255 のオクテット範囲を厳密に判定し、version 番号 (例: 1.2.3.4) 風の文字列に
      # 過剰反応しないようにする
      # 注意 "1.2.3.4" のような短い valid IPv4 はそれ自体がセマンティックバージョンの命名と
      # 衝突するため、リリースノート等のアプリ文脈で偽陽性が出る可能性がある
      # その場合はこのルールを無効化するか、negative lookbehind 非対応の RE2 制約下で
      # 単純な "version|v" 文字列を先頭で弾く別ルールを足すことを検討する
      - id: ipv4
        regex: "\\b(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}\\b"
        replacement: "[REDACTED:IPV4]"

# OpenTelemetry 計装。enabled: true で OTLP HTTP exporter にトレースとメトリクスを送る。
# 既定は無効で、有効化しても他機能の挙動は変えない。詳細は docs/design/01-otel-instrumentation.md を参照する。
observability:
  otel:
    enabled: false
    exporter: otlp_http
    endpoint: 127.0.0.1:4318
    insecure: true
    sample_ratio: 1.0
    service_name: go-llm-agent
    metrics_interval_seconds: 30
